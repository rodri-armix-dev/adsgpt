---
import Button from '../../components/atoms/Button/Button.astro';
import Description from '../../components/atoms/Description/Description.astro';
import Icon, { iconRegistry } from '../../components/atoms/Icon/Icon.astro';
import Heading from '../../components/atoms/Heading/Heading.astro';
import type { ComponentProps } from 'astro/types';
import { isLocale, locales } from '../../i18n/config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { uiData } from '../../data/pages/ui';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
if (!isLocale(locale)) return new Response(null, { status: 404 });

const page = uiData[locale];
const iconNames = Object.keys(iconRegistry) as ComponentProps<typeof Icon>['name'][];

type ButtonVariant = NonNullable<ComponentProps<typeof Button>['variant']>;
const variants = [
	{ name: 'secondary', label: page.login },
	{ name: 'primary', label: page.download },
] satisfies { name: ButtonVariant; label: string }[];
---

<BaseLayout locale={locale} title="UI | adsgpt" description={page.description}>
	<div class="ui">
		<header class="ui__intro">
			<p class="ui__eyebrow">{page.eyebrow}</p>
			<h1>UI</h1>
			<p>{page.intro}</p>
			<p>{page.instructions}</p>
		</header>
		<section class="ui__section" aria-labelledby="heading-examples">
			<h2 id="heading-examples">Heading</h2>
			<div class="ui__typography">
				<Heading label="Heading extra-small · 14px" size="extra-small" tag="p" />
				<Heading label="Heading compact · 20px" size="compact" tag="p" />
				<Heading label="Heading medium · 36px" size="medium" tag="p" />
				<Heading label="Heading small · 24px" size="small" tag="p" />
				<Heading label="Heading normal · 45px" tag="p" />
				<Heading label="Heading large · 64px" size="large" tag="p" />
				<Heading label="Heading extra-large · 72px" size="extra-large" tag="p" />
				<Heading label="Responsive · 36px → 45px" size="medium" responsiveSize={{ l: "normal" }} tag="p" />
				<Heading size="small" tag="p">{page.slot}</Heading>
			</div>
		</section>
		<section class="ui__section" aria-labelledby="description-examples">
			<h2 id="description-examples">Description</h2>
			<div class="ui__typography">
				{(['extra-small', 'small', 'normal', 'large'] as const).map((size) => (
					<div>
						<p>{size}</p>
						<Description html={page.example} size={size} />
					</div>
				))}
				<div>
					<p>Responsive · 14px → 21px</p>
					<Description html={page.example} size="extra-small" responsiveSize={{ l: "large" }} />
				</div>
			</div>
		</section>
		<section class="ui__section" aria-labelledby="icon-examples">
			<h2 id="icon-examples">Icon</h2>
			<p>{page.iconInstructions}</p>
			<div class="ui__icons">
				{iconNames.map((name) => (
					<div class="ui__icon-sample">
						<Icon name={name} label={name} />
						<code>{name}</code>
					</div>
				))}
			</div>
			<div class="ui__icon-settings">
				{[12, 24, 40].map((size) => (
					<div class="ui__icon-size" style={`--icon-size: ${size}px`}>
						<Icon name="star-filled" />
						<span>{size}px</span>
					</div>
				))}
				<div class="ui__icon-inherited">
					<Icon name="arrow-up-right" />
					<span>{page.iconInherited}</span>
				</div>
				<div class="ui__icon-custom">
					<Icon name="download-smartphone" />
					<span>--icon-color</span>
				</div>
				<div class="ui__icon-repeat">
					<Icon name="battery" label={page.iconBattery} />
					<Icon name="battery" label={page.iconBattery} />
				</div>
			</div>
		</section>
		{variants.map(({ name, label }) =>
			<section class="ui__section" aria-labelledby={`title-${name}`}>
				<h2 id={`title-${name}`}>{name}</h2>
				<div class="ui__example">
					<Button label={label} variant={name} />
				</div>
			</section>
		)}
	</div>
</BaseLayout>

<style lang="scss">
	@use '../ui';
</style>
