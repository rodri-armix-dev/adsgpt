---
import Button from '../../atoms/Button/Button.astro';
import Lottie from '../../atoms/Lottie/Lottie.astro';
import PhoneMockup from '../PhoneMockup/PhoneMockup.astro';
import { defaultLocale, isLocale } from '../../../i18n/config';

export interface Props {
	src: string;
	label: string;
	mode?: 'animation' | 'phone';
}

const { src, label, mode = 'animation' } = Astro.props;
const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const text = {
	es: { width: 'Ancho del teléfono', play: 'Reproducir', pause: 'Pausar', loop: 'Repetir', controls: 'Reproducción', progress: 'Progreso', loading: 'Cargando…', playing: 'Reproduciendo', paused: 'En pausa', ended: 'Finalizado', error: 'No se pudo cargar la animación.' },
	en: { width: 'Phone width', play: 'Play', pause: 'Pause', loop: 'Loop', controls: 'Playback', progress: 'Progress', loading: 'Loading…', playing: 'Playing', paused: 'Paused', ended: 'Finished', error: 'Could not load the animation.' },
	pt: { width: 'Largura do celular', play: 'Reproduzir', pause: 'Pausar', loop: 'Repetir', controls: 'Reprodução', progress: 'Progresso', loading: 'Carregando…', playing: 'Reproduzindo', paused: 'Em pausa', ended: 'Finalizado', error: 'Não foi possível carregar a animação.' },
}[locale];
const widthLabel = text.width;
---

<lottie-preview class="lottie-preview" data-mode={mode} data-playing={text.playing} data-paused={text.paused} data-ended={text.ended} data-error={text.error}>
	<figure class="lottie-preview__figure">
		<div class="lottie-preview__animation">
			{mode === 'phone' ? (
				<PhoneMockup src={src} autoplay={false} ariaLabel={label} />
			) : (
				<Lottie src={src} autoplay={false} />
			)}
		</div>
		<figcaption class="lottie-preview__caption">{label}</figcaption>
	</figure>
	{mode === 'phone' && (
		<label class="lottie-preview__width">
			<span class="lottie-preview__progress-label">{widthLabel}<output data-width-output>300 px</output></span>
			<input class="lottie-preview__range" type="range" name="width" min="180" max="600" step="1" value="300" aria-label={`${widthLabel}: ${label}`} />
		</label>
	)}
	<fieldset class="lottie-preview__controls" disabled aria-label={`${text.controls}: ${label}`}>
		<div class="lottie-preview__actions">
			<div class="lottie-preview__action" data-action="play">
				<Button label={text.play} />
			</div>
			<div class="lottie-preview__action" data-action="pause">
				<Button label={text.pause} variant="secondary" />
			</div>
			<label class="lottie-preview__loop">
				<input class="lottie-preview__checkbox" type="checkbox" name="loop" checked />
				<span>{text.loop}</span>
			</label>
		</div>
		<label class="lottie-preview__progress">
			<span class="lottie-preview__progress-label">{text.progress}<output aria-live="off">0%</output></span>
			<input class="lottie-preview__range" type="range" name="progress" min="0" max="100" step="0.1" value="0" aria-label={`${text.progress}: ${label}`} />
		</label>
	</fieldset>
	<p class="lottie-preview__status" role="status">{text.loading}</p>
</lottie-preview>

<script>
	class LottiePreview extends HTMLElement {
		private controller?: AbortController;

		connectedCallback() {
			if (this.controller) return;
			this.controller = new AbortController();
			const { signal } = this.controller;
			const player = this.querySelector('lottie-animation');
			const controls = this.querySelector('fieldset');
			const play = this.querySelector<HTMLButtonElement>('[data-action="play"] button');
			const pause = this.querySelector<HTMLButtonElement>('[data-action="pause"] button');
			const loop = this.querySelector<HTMLInputElement>('[name="loop"]');
			const progress = this.querySelector<HTMLInputElement>('[name="progress"]');
			const output = this.querySelector<HTMLOutputElement>('.lottie-preview__progress output');
			const status = this.querySelector('[role="status"]');
			const width = this.querySelector<HTMLInputElement>('[name="width"]');
			const widthOutput = this.querySelector<HTMLOutputElement>('[data-width-output]');
			const animation = this.querySelector<HTMLElement>('.lottie-preview__animation');
			if (width && widthOutput && animation) {
				width.addEventListener('input', () => {
					animation.style.setProperty('--phone-mockup-width', `${width.value}px`);
					widthOutput.value = `${width.value} px`;
				}, { signal });
			}
			if (!player || !controls || !play || !pause || !loop || !progress || !output || !status) return;

			const sync = () => {
				controls.disabled = !player.ready;
				play.disabled = player.playing;
				pause.disabled = !player.playing;
				loop.checked = player.loop;
				progress.value = String(player.progress * 100);
				output.value = `${Math.round(player.progress * 100)}%`;
				if (player.ready) {
					const message = player.playing ? this.dataset.playing : player.progress >= 1 ? this.dataset.ended : this.dataset.paused;
					if (status.textContent !== message) status.textContent = message ?? '';
				}
			};

			play.addEventListener('click', () => player.play(), { signal });
			pause.addEventListener('click', () => player.pause(), { signal });
			loop.addEventListener('change', () => player.setLoop(loop.checked), { signal });
			progress.addEventListener('input', () => player.setProgress(Number(progress.value) / 100), { signal });
			for (const event of ['lottie:ready', 'lottie:progress', 'lottie:state']) {
				player.addEventListener(event, sync, { signal });
			}
			player.addEventListener('lottie:error', () => {
				controls.disabled = true;
				status.textContent = this.dataset.error ?? '';
			}, { signal });
			// The atom's script can register before or after this preview's script.
			void customElements.whenDefined('lottie-animation').then(() => {
				if (!signal.aborted) sync();
			});
		}

		disconnectedCallback() {
			this.controller?.abort();
			this.controller = undefined;
		}
	}

	if (!customElements.get('lottie-preview')) {
		customElements.define('lottie-preview', LottiePreview);
	}
</script>

<style lang="scss">
	@use './lottie-preview';
</style>
