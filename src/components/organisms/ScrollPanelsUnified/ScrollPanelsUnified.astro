---
import { getUiText } from '../../../i18n/ui';
import type { ComponentProps } from 'astro/types';
import ScrollPanelsItem from '../../molecules/ScrollPanelsItem/ScrollPanelsItem.astro';
import PhoneMockup from '../../molecules/PhoneMockup/PhoneMockup.astro';
import Lottie from '../../atoms/Lottie/Lottie.astro';

export interface Props {
	items: ComponentProps<typeof ScrollPanelsItem>[];
}

const text = getUiText(Astro.currentLocale);
const { items: steps } = Astro.props;
---

<scroll-panels-unified class="scroll-panels-unified" role="region" aria-label={text.howItWorks}>
	{steps.length > 0 && (
		<Fragment>
			<div class="scroll-panels-unified__scene">
				{steps.map((item, index) => (
					<div class="scroll-panels-unified__step" data-step={index} data-context={item.context} aria-hidden={index > 0 ? 'true' : undefined} inert={index > 0}>
						<ScrollPanelsItem {...item} />
					</div>
				))}
			</div>
			{steps[0]?.lottieSrc && (
				<div class="scroll-panels-unified__phone-layout global-inner">
					<div class="scroll-panels-unified__phone">
						<PhoneMockup src={steps[0].lottieSrc} autoplay={false} loop={false}>
							<div class="scroll-panels-unified__animations" slot="animation">
								{steps.map((item, index) => (
									<div class="scroll-panels-unified__animation" data-animation-step={index} aria-hidden={index > 0 ? 'true' : undefined} inert={index > 0}>
										{item.lottieSrc && (
											<Lottie src={item.lottieSrc} progressiveLoad={item.lottieProgressiveLoad} loading="manual" autoplay={false} loop={true} ariaLabel={item.image.alt} />
										)}
									</div>
								))}
							</div>
						</PhoneMockup>
					</div>
					<div class="scroll-panels-unified__phone-cut" aria-hidden="true"></div>
				</div>
			)}
		</Fragment>
	)}
</scroll-panels-unified>

<script>
	// Reservar el layout desde el principio; cargar el controlador cerca de la sección.
	const observer = new IntersectionObserver((entries) => {
		if (!entries.some(entry => entry.isIntersecting)) return;
		observer.disconnect();
		void import('./scroll-panels-unified.ts');
	}, { rootMargin: '800px 0px' });
	for (const section of document.querySelectorAll('scroll-panels-unified')) observer.observe(section);
</script>

<style lang="scss">
	@use './scroll-panels-unified' as scrollPanels;
</style>
