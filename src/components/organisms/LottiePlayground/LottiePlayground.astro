---
import Button from '../../atoms/Button/Button.astro';
import { lottieReviewFiles, reviewLocations } from '../../../data/lottie-review';

export interface Props {}
const locations = reviewLocations.map(label => ({ label, width: lottieReviewFiles.find(file => file.usage === label)!.previewWidth }));
---

<lottie-playground class="lottie-playground">
	<section class="lottie-playground__inner global-inner" aria-labelledby="playground-title">
		<header class="lottie-playground__intro">
			<p class="lottie-playground__eyebrow">AdsGPT · Prueba de animaciones</p>
			<h1 class="lottie-playground__title" id="playground-title">Prueba tus Lotties</h1>
			<p>Carga una animación y elige su ubicación en el diseño para verla al tamaño real. Empieza pausada.</p>
			<p>Los archivos se procesan en tu navegador y no se guardan en el servidor. Al cerrar o recargar la página, se descartan.</p>
			<a class="lottie-playground__link" href="/es/revision-lotties/">Ver los Lotties del proyecto ↗</a>
		</header>
		<div class="lottie-playground__drop" data-drop>
			<label class="lottie-playground__field">Arrastra aquí un archivo o selecciónalo <input type="file" accept=".json,.lottie" data-file /></label>
			<p>JSON o dotLottie. Si el JSON usa imágenes externas, selecciónalas también en el campo de abajo.</p>
		</div>
		<div class="lottie-playground__settings">
			<label class="lottie-playground__field">Ubicación en el diseño <select data-location><option value="510">Teléfono del Hero</option>{locations.filter(location => location.label !== 'Teléfono del Hero').map(location => (
				<option value={location.width}>{location.label}</option>
			))}<option value="original">Tamaño original del archivo</option></select></label>
			<label class="lottie-playground__field">Imágenes externas del JSON <input type="file" accept="image/png,image/jpeg,image/webp,image/gif" multiple data-images /></label>
			<label class="lottie-playground__field" data-animation-field hidden>Animación dentro del dotLottie <select data-animation></select></label>
			<label class="lottie-playground__field">Fondo de prueba <select data-background><option value="light">Claro</option><option value="dark">Oscuro</option><option value="grid">Transparencia</option></select></label>
		</div>
		<p class="lottie-playground__message" data-message role="status" aria-live="polite">Selecciona un archivo para comenzar.</p>
		<p class="lottie-playground__metadata" data-metadata></p>
		<div class="lottie-playground__controls">
			<div data-action="play"><Button label="Play" disabled /></div>
			<div data-action="pause"><Button label="Pause" variant="secondary" disabled /></div>
			<div data-action="restart"><Button label="Volver al inicio" variant="secondary" disabled /></div>
			<label class="lottie-playground__loop"><input type="checkbox" checked data-loop /> Repetir</label>
		</div>
		<label class="lottie-playground__progress">Recorrer animación <input type="range" min="0" max="1000" step="1" value="0" disabled data-progress /></label>
		<p class="lottie-playground__metadata" data-size>La vista mantiene el tamaño real. Si no cabe, desplaza el área horizontalmente.</p>
		<div class="lottie-playground__stage" data-stage data-background="light" tabindex="0" role="region" aria-label="Vista de la animación a tamaño real">
			<div class="lottie-playground__canvas" data-canvas></div>
		</div>
	</section>
</lottie-playground>

<script src="./lottie-playground.ts"></script>

<style lang="scss">
	@use './lottie-playground';
</style>
