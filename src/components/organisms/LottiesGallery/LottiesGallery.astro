---
import LottiePreview from '../../molecules/LottiePreview/LottiePreview.astro';
import Heading from '../../atoms/Heading/Heading.astro';
import { defaultLocale, isLocale } from '../../../i18n/config';

export interface Props {
	files: string[];
	intro: string;
}

const { files, intro } = Astro.props;
const phoneFiles = ['describe.json', 'conecta.json', 'crea.json', 'lanza.json'].filter((file) => files.includes(file));
const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const phoneText = {
	es: { title: 'Teléfonos', intro: 'Ajustá el ancho para comprobar cómo escalan el dispositivo, la animación y la barra de estado. La hora corresponde a la de tu dispositivo.' },
	en: { title: 'Phones', intro: 'Adjust the width to check how the device, animation and status bar scale together. The clock uses your device’s local time.' },
	pt: { title: 'Celulares', intro: 'Ajuste a largura para conferir como o dispositivo, a animação e a barra de status são redimensionados juntos. O relógio usa a hora local do seu dispositivo.' },
}[locale];
---

<section class="lotties-gallery global-inner" aria-labelledby="lotties-title">
	<header class="lotties-gallery__intro">
		<Heading id="lotties-title" tag="h1" label="Lotties" />
		<p>{intro}</p>
	</header>
	<div class="lotties-gallery__grid">
		{files.map((file) => (
			<LottiePreview src={`/lotties/${file}`} label={file} />
		))}
	</div>
	<section class="lotties-gallery__phones" aria-labelledby="phones-title">
		<header class="lotties-gallery__intro">
			<Heading id="phones-title" tag="h2" label={phoneText.title} />
			<p>{phoneText.intro}</p>
		</header>
		<div class="lotties-gallery__phone-grid">
			{phoneFiles.map((file) => (
				<LottiePreview src={`/lotties/${file}`} label={file} mode="phone" />
			))}
		</div>
	</section>
</section>

<style lang="scss">
	@use './lotties-gallery';
</style>
