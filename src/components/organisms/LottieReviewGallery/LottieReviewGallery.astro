---
import Button from '../../atoms/Button/Button.astro';
import LottieReviewItem from '../../molecules/LottieReviewItem/LottieReviewItem.astro';
import { lottieReviewFiles, reviewLocations, reviewFolders, reviewSourceFolder } from '../../../data/lottie-review';

export interface Props {}
---

<section class="lottie-review-gallery" data-review-gallery aria-labelledby="lottie-review-title">
	<div class="lottie-review-gallery__inner global-inner">
		<header class="lottie-review-gallery__intro">
			<p class="lottie-review-gallery__eyebrow">AdsGPT · Revisión de animaciones</p>
			<h1 class="lottie-review-gallery__title" id="lottie-review-title">Lotties a tamaño real</h1>
			<p>{lottieReviewFiles.length} archivos de Drive, ordenados por su última modificación. Todas las animaciones empiezan pausadas.</p>
			<p>Cada archivo tiene un número fijo para que puedas indicar cuál quieres usar.</p>
			<p>La vista usa el mayor tamaño de cada animación en el sitio. Si no cabe en tu pantalla, desplaza el área de prueba horizontalmente: la animación no se reduce.</p>
			<a class="lottie-review-gallery__drive" href="/es/probar-lotties/">Probar un archivo de tu computadora ↗</a>
			<a class="lottie-review-gallery__drive" href={reviewSourceFolder} target="_blank" rel="noopener noreferrer">Abrir carpeta de Drive ↗</a>
		</header>
		<form class="lottie-review-gallery__filters" data-filters>
			<label class="lottie-review-gallery__field">Buscar archivo <input type="search" name="search" placeholder="Número, nombre o ruta" /></label>
			<label class="lottie-review-gallery__field">Ubicación en el diseño <select name="location"><option value="">Todas</option>{reviewLocations.map(location => (
				<option value={location}>{location}</option>
			))}</select></label>
			<label class="lottie-review-gallery__field">Carpeta <select name="folder"><option value="">Todas</option>{Object.entries(reviewFolders).map(([value, label]) => (
				<option value={value}>{label}</option>
			))}</select></label>
			<label class="lottie-review-gallery__field">Formato <select name="format"><option value="">Todos</option><option value="json">JSON</option><option value="dotlottie">dotLottie</option></select></label>
			<div data-action="pause-all"><Button label="Pausar todos" variant="secondary" /></div>
		</form>
		<p class="lottie-review-gallery__count" data-count aria-live="polite">{lottieReviewFiles.length} archivos</p>
		<p class="lottie-review-gallery__empty" data-empty hidden>No hay archivos con esos filtros. Prueba otra ubicación, carpeta o número.</p>
		<div class="lottie-review-gallery__list">
			{lottieReviewFiles.map(file => (
				<LottieReviewItem file={file} />
			))}
		</div>
	</div>
</section>

<script src="./lottie-review-gallery.ts"></script>

<style lang="scss">
	@use './lottie-review-gallery';
</style>
